FROM node:20-slim

WORKDIR /app

COPY --chown=node:node package*.json ./
RUN npm install

# Retain the frontend build manifests and vendored partner package that were
# published with the integration portal release.
COPY --chown=node:node index.html vite.config.ts tsconfig*.json tailwind.config.js postcss.config.js ./
COPY --chown=node:node src ./src
COPY --chown=node:node public-artifacts ./public

RUN chown -R node:node /app

USER node

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
